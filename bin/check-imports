#!/usr/bin/env sh
# Forbidden framework namespaces in the packages (docs/extraction/spec.md §0.6): none, anywhere.
# Blocking since WP7 for Altair\, Cycle\ and Univeros\ in every package's src and tests.
set -u
cd "$(dirname "$0")/.."

violations=$(grep -rnE --include='*.php' 'Altair\\|Cycle\\|Univeros\\' packages/*/src packages/*/tests 2>/dev/null)
if [ -n "$violations" ]; then
    printf 'Forbidden framework references:\n%s\n' "$violations"
    exit 1
fi
printf 'No Altair\\, Cycle\\ or Univeros\\ reference in packages/*/src or packages/*/tests.\n'
