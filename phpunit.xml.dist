<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="core">
            <directory>packages/core/tests</directory>
            <exclude>packages/core/tests/Functional</exclude>
            <exclude>packages/core/tests/Contract</exclude>
        </testsuite>
        <!-- The functional suite and the contract freeze; POLARIS_HARNESS runs them through a framework's kernel. -->
        <testsuite name="functional">
            <directory>packages/core/tests/Functional</directory>
            <directory>packages/core/tests/Contract</directory>
            <directory>packages/audit/tests/Functional</directory>
            <directory>packages/admin/tests/Functional</directory>
            <directory>packages/sentinel/tests/Functional</directory>
            <directory>packages/sso/tests/Functional</directory>
            <directory>packages/scim/tests/Functional</directory>
            <directory>packages/passwordless/tests/Functional</directory>
            <directory>packages/username/tests/Functional</directory>
            <directory>packages/anonymous/tests/Functional</directory>
            <directory>packages/multi-session/tests/Functional</directory>
            <directory>packages/passkey/tests/Functional</directory>
            <directory>packages/social/tests/Functional</directory>
            <directory>packages/api-keys/tests/Functional</directory>
        </testsuite>
        <testsuite name="api-keys">
            <directory>packages/api-keys/tests</directory>
            <exclude>packages/api-keys/tests/Functional</exclude>
        </testsuite>
        <testsuite name="passkey">
            <directory>packages/passkey/tests</directory>
            <exclude>packages/passkey/tests/Functional</exclude>
        </testsuite>
        <testsuite name="social">
            <directory>packages/social/tests</directory>
            <exclude>packages/social/tests/Functional</exclude>
        </testsuite>
        <testsuite name="passwordless">
            <directory>packages/passwordless/tests</directory>
            <exclude>packages/passwordless/tests/Functional</exclude>
        </testsuite>
        <testsuite name="username">
            <directory>packages/username/tests</directory>
            <exclude>packages/username/tests/Functional</exclude>
        </testsuite>
        <testsuite name="anonymous">
            <directory>packages/anonymous/tests</directory>
            <exclude>packages/anonymous/tests/Functional</exclude>
        </testsuite>
        <testsuite name="multi-session">
            <directory>packages/multi-session/tests</directory>
            <exclude>packages/multi-session/tests/Functional</exclude>
        </testsuite>
        <testsuite name="scim">
            <directory>packages/scim/tests</directory>
            <exclude>packages/scim/tests/Functional</exclude>
        </testsuite>
        <testsuite name="sso">
            <directory>packages/sso/tests</directory>
            <exclude>packages/sso/tests/Functional</exclude>
        </testsuite>
        <testsuite name="sentinel">
            <directory>packages/sentinel/tests</directory>
            <exclude>packages/sentinel/tests/Functional</exclude>
        </testsuite>
        <testsuite name="messaging">
            <directory>packages/messaging/tests</directory>
        </testsuite>
        <testsuite name="admin">
            <directory>packages/admin/tests</directory>
            <exclude>packages/admin/tests/Functional</exclude>
        </testsuite>
        <testsuite name="audit">
            <directory>packages/audit/tests</directory>
            <exclude>packages/audit/tests/Functional</exclude>
        </testsuite>
        <testsuite name="laravel">
            <directory>packages/laravel/tests</directory>
        </testsuite>
        <testsuite name="symfony">
            <directory>packages/symfony/tests</directory>
        </testsuite>
        <testsuite name="yii">
            <directory>packages/yii/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>packages/core/src</directory>
            <directory>packages/testing/src</directory>
            <directory>packages/pdo/src</directory>
            <directory>packages/psr15/src</directory>
            <directory>packages/cli/src</directory>
            <directory>packages/laravel/src</directory>
            <directory>packages/symfony/src</directory>
            <directory>packages/yii/src</directory>
            <directory>packages/audit/src</directory>
            <directory>packages/admin/src</directory>
            <directory>packages/messaging/src</directory>
            <directory>packages/sentinel/src</directory>
            <directory>packages/sso/src</directory>
            <directory>packages/scim/src</directory>
            <directory>packages/passwordless/src</directory>
            <directory>packages/username/src</directory>
            <directory>packages/anonymous/src</directory>
            <directory>packages/multi-session/src</directory>
            <directory>packages/passkey/src</directory>
            <directory>packages/social/src</directory>
            <directory>packages/api-keys/src</directory>
        </include>
    </source>
</phpunit>
