<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="core">
            <directory>packages/core/tests</directory>
            <exclude>packages/core/tests/Functional</exclude>
            <exclude>packages/core/tests/Contract</exclude>
        </testsuite>
        <!-- The functional suite and the contract freeze; POLARIS_HARNESS runs them through a framework's kernel. -->
        <testsuite name="functional">
            <directory>packages/core/tests/Functional</directory>
            <directory>packages/core/tests/Contract</directory>
            <directory>packages/audit/tests/Functional</directory>
            <directory>packages/admin/tests/Functional</directory>
        </testsuite>
        <testsuite name="messaging">
            <directory>packages/messaging/tests</directory>
        </testsuite>
        <testsuite name="admin">
            <directory>packages/admin/tests</directory>
            <exclude>packages/admin/tests/Functional</exclude>
        </testsuite>
        <testsuite name="audit">
            <directory>packages/audit/tests</directory>
            <exclude>packages/audit/tests/Functional</exclude>
        </testsuite>
        <testsuite name="laravel">
            <directory>packages/laravel/tests</directory>
        </testsuite>
        <testsuite name="symfony">
            <directory>packages/symfony/tests</directory>
        </testsuite>
        <testsuite name="yii">
            <directory>packages/yii/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>packages/core/src</directory>
            <directory>packages/testing/src</directory>
            <directory>packages/pdo/src</directory>
            <directory>packages/psr15/src</directory>
            <directory>packages/cli/src</directory>
            <directory>packages/laravel/src</directory>
            <directory>packages/symfony/src</directory>
            <directory>packages/yii/src</directory>
            <directory>packages/audit/src</directory>
            <directory>packages/admin/src</directory>
            <directory>packages/messaging/src</directory>
        </include>
    </source>
</phpunit>
