APP_NAME=Polaris
APP_ENV=local
# Laravel's key; Polaris derives its own keys from it (or set POLARIS_APP_KEY). bin/setup fills it in.
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080
LOG_CHANNEL=single
# Rate limits and the denylist live in the cache; a shared store in production.
CACHE_STORE=file
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
DB_CONNECTION=sqlite

AUTH_ISSUER=http://127.0.0.1:8080
# PEM files generated by bin/setup (or your own RS256 key pair).
AUTH_JWT_PRIVATE_KEY_FILE=storage/keys/private.pem
AUTH_JWT_PUBLIC_KEY_FILE=storage/keys/public.pem
AUTH_JWT_KID=demo-key-1
