#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * One-time setup: .env with generated secrets, an RS256 key pair, the SQLite schema through
 * `polaris:schema:create`, then `polaris:schema:diff` and `polaris:doctor` as the proof. Safe to run again.
 */

$root = dirname(__DIR__);

if (!is_file("$root/.env")) {
    $env = (string) file_get_contents("$root/.env.example");
    $env = preg_replace('/^APP_SECRET=.*$/m', 'APP_SECRET=' . bin2hex(random_bytes(16)), $env);
    $env = preg_replace('/^POLARIS_APP_KEY=.*$/m', 'POLARIS_APP_KEY=' . bin2hex(random_bytes(24)), $env);
    file_put_contents("$root/.env", $env);
    echo "created .env\n";
}
@mkdir("$root/var/keys", 0700, true);
if (!is_file("$root/var/keys/private.pem")) {
    $key = openssl_pkey_new(['private_key_bits' => 2048, 'private_key_type' => OPENSSL_KEYTYPE_RSA]);
    if ($key === false) {
        fwrite(STDERR, "openssl could not generate a key pair\n");
        exit(1);
    }
    openssl_pkey_export($key, $private);
    file_put_contents("$root/var/keys/private.pem", $private);
    file_put_contents("$root/var/keys/public.pem", openssl_pkey_get_details($key)['key']);
    chmod("$root/var/keys/private.pem", 0600);
    echo "generated var/keys/{private,public}.pem\n";
}

$commands = is_file("$root/var/polaris.sqlite") ? [] : ['polaris:schema:create'];
foreach ([...$commands, 'polaris:schema:diff', 'polaris:doctor'] as $command) {
    echo "\n$ bin/console $command\n";
    passthru(PHP_BINARY . ' ' . escapeshellarg("$root/bin/console") . ' ' . $command, $status);
    if ($status !== 0) {
        fwrite(STDERR, "bin/console $command failed ($status)\n");
        exit($status);
    }
}
echo "\nNext: php -S 127.0.0.1:8080 -t public   then   bin/walkthrough.sh\n";
