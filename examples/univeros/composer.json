{
    "name": "polaris/example-univeros",
    "description": "Polaris for PHP demo: Univeros 2 + polaris/psr15 + polaris/pdo on SQLite",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "polaris/cli": "0.1.x-dev",
                    "polaris/core": "0.1.x-dev",
                    "polaris/laravel": "0.1.x-dev",
                    "polaris/pdo": "0.1.x-dev",
                    "polaris/psr15": "0.1.x-dev",
                    "polaris/symfony": "0.1.x-dev",
                    "polaris/testing": "0.1.x-dev",
                    "polaris/yii": "0.1.x-dev"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-pdo_sqlite": "*",
        "polaris/cli": "0.1.x-dev",
        "polaris/core": "0.1.x-dev",
        "polaris/pdo": "0.1.x-dev",
        "polaris/psr15": "0.1.x-dev",
        "univeros/framework": "^2.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "PolarisDemo\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
