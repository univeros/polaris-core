#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * One-time setup: .env from .env.example, an RS256 key pair, the SQLite schema, the permission
 * catalog and system roles. Safe to run again.
 */

use Polaris\Authorization\PermissionCatalog;
use Polaris\Authorization\PermissionCatalogSeeder;
use Polaris\Contract\Dialect;
use Polaris\Pdo\PdoAdapter;
use Polaris\Pdo\SqlSchema;
use PolarisDemo\Env;

$root = dirname(__DIR__);
require $root . '/vendor/autoload.php';

if (!is_file("$root/.env")) {
    $env = (string) file_get_contents("$root/.env.example");
    $env = preg_replace('/^APP_KEY=.*$/m', 'APP_KEY=' . bin2hex(random_bytes(24)), $env);
    file_put_contents("$root/.env", $env);
    echo "created .env\n";
}
@mkdir("$root/var/keys", 0700, true);
if (!is_file("$root/var/keys/private.pem")) {
    $key = openssl_pkey_new(['private_key_bits' => 2048, 'private_key_type' => OPENSSL_KEYTYPE_RSA]);
    if ($key === false) {
        fwrite(STDERR, "openssl could not generate a key pair\n");
        exit(1);
    }
    openssl_pkey_export($key, $private);
    file_put_contents("$root/var/keys/private.pem", $private);
    file_put_contents("$root/var/keys/public.pem", openssl_pkey_get_details($key)['key']);
    chmod("$root/var/keys/private.pem", 0600);
    echo "generated var/keys/{private,public}.pem\n";
}

Env::load($root);
$dsn = Env::require('POLARIS_DSN');
$path = Env::sqlitePath($root, $dsn);
$fresh = !is_file($path);
$pdo = new PDO('sqlite:' . $path);
$pdo->exec('PRAGMA foreign_keys = ON');
$adapter = new PdoAdapter($pdo);
if ($fresh) {
    foreach (SqlSchema::createAll(Dialect::Sqlite) as $statement) {
        $adapter->exec($statement);
    }
    echo "created $path with the Polaris schema\n";
}
(new PermissionCatalogSeeder(new PermissionCatalog()))->seed($adapter, new DateTimeImmutable('now'));
echo "seeded the permission catalog and system roles\n";
echo "\nNext: php -S 127.0.0.1:8080 -t public   then   bin/walkthrough.sh\n";
