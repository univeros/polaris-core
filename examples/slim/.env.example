# Copy to .env (bin/setup does this and fills in the keys).
APP_KEY=change-me-to-32-random-bytes-or-more-000
AUTH_ISSUER=http://127.0.0.1:8080
# PEM files generated by bin/setup (or your own RS256 key pair).
AUTH_JWT_PRIVATE_KEY_FILE=var/keys/private.pem
AUTH_JWT_PUBLIC_KEY_FILE=var/keys/public.pem
AUTH_JWT_KID=demo-key-1
POLARIS_DSN=sqlite:var/polaris.sqlite
