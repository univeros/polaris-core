# Polaris's app key (at least 32 bytes); bin/setup fills it in.
POLARIS_APP_KEY=
AUTH_ISSUER=http://127.0.0.1:8080
# PEM files generated by bin/setup (or your own RS256 key pair), relative to the project directory.
AUTH_JWT_PRIVATE_KEY_FILE=var/keys/private.pem
AUTH_JWT_PUBLIC_KEY_FILE=var/keys/public.pem
AUTH_JWT_KID=demo-key-1
