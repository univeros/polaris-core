#!/usr/bin/env php
<?php

declare(strict_types=1);

foreach ([__DIR__ . '/../../../vendor/autoload.php', __DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

// POLARIS_BOOTSTRAP names the application, so its plugins' commands are available too.
exit((new Polaris\Cli\Application(Polaris\Cli\Bootstrap::load(null)))->run());
