{
    "name": "polaris/agents",
    "description": "AI agents as principals for Polaris for PHP: registration and host enrolment, delegated and autonomous agents over OAuth (token exchange with act, client credentials, private_key_jwt), signed request JWTs, capability grants with constraints and budgets, approvals, signed receipt chains and a kill switch",
    "type": "library",
    "keywords": ["polaris", "ai-agents", "agent-auth", "agent-authentication", "agentic", "delegation", "token-exchange", "capabilities", "approvals", "receipts", "mcp", "oauth2", "php"],
    "license": "MIT",
    "authors": [
        {
            "name": "2am.tech",
            "homepage": "https://2am.tech"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-openssl": "*",
        "firebase/php-jwt": "^7.0",
        "lcobucci/jwt": "^5.0",
        "opis/json-schema": "^2.4",
        "polaris/admin": "^0.11",
        "polaris/audit": "^0.11",
        "polaris/core": "^0.11",
        "polaris/mcp": "^0.11",
        "polaris/oauth-provider": "^0.11",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/simple-cache": "^3.0",
        "symfony/uid": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Polaris\\Agents\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.11.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
