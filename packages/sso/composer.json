{
    "name": "polaris/sso",
    "description": "SSO for Polaris for PHP: per-organization SAML 2.0 and OIDC providers, verified domains, just-in-time provisioning, single logout, organization self-service and operator routes",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "2am.tech",
            "homepage": "https://2am.tech"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-dom": "*",
        "ext-openssl": "*",
        "firebase/php-jwt": "^7.0",
        "onelogin/php-saml": "^4.3",
        "polaris/admin": "^0.6",
        "polaris/audit": "^0.6",
        "polaris/core": "^0.6",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0",
        "symfony/uid": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Polaris\\Sso\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.6.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
