[
    {
        "request": {
            "method": "POST",
            "uri": "/auth/password/change",
            "headers": {
                "Content-Type": [
                    "application/json"
                ]
            },
            "body": {
                "current_password": "correct horse battery staple",
                "new_password": "an entirely different passphrase"
            }
        },
        "response": {
            "status": 401,
            "headers": {
                "Content-Type": [
                    "application/json"
                ],
                "WWW-Authenticate": [
                    "Bearer"
                ]
            },
            "body": {
                "error": "unauthorized",
                "message": "Authentication is required."
            }
        }
    }
]
