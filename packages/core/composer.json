{
    "name": "polaris/core",
    "description": "Polaris for PHP core: authentication, MFA/OTP, sessions, multi-tenant organizations and RBAC, framework-free",
    "type": "library",
    "license": "MIT",
    "keywords": ["authentication", "mfa", "otp", "totp", "rbac", "users", "organizations", "jwt"],
    "require": {
        "php": ">=8.3",
        "endroid/qr-code": "^6.0",
        "psr/http-client": "^1.0",
        "spomky-labs/otphp": "^11.3",
        "symfony/uid": "^7.0",
        "univeros/http": "^2.0",
        "univeros/module": "^2.0",
        "univeros/observability": "^2.0",
        "univeros/persistence": "^2.0",
        "univeros/security": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Univeros\\Polaris\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Univeros\\Polaris\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
