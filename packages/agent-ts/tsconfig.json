{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2022", "DOM"],
        "strict": true,
        "exactOptionalPropertyTypes": true,
        "noUncheckedIndexedAccess": true,
        "declaration": true,
        "skipLibCheck": true,
        "types": ["node"],
        "noEmit": true
    },
    "include": ["src", "test", "e2e"]
}
