{
    "name": "polaris/audit",
    "description": "Audit for Polaris for PHP: a catalogued, redacted, append-only audit store with sinks, per-organization drains, a query API, retention and an optional hash chain",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "2am.tech",
            "homepage": "https://2am.tech"
        }
    ],
    "require": {
        "php": ">=8.3",
        "polaris/cli": "^0.6",
        "polaris/core": "^0.6",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0",
        "symfony/console": "^7.0 || ^8.0",
        "symfony/uid": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Polaris\\Audit\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.6.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
