#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Writes src/Routes.php, the route table of the agents, oauth and core routes the SDK calls (method,
 * path, path parameters, body fields and the required ones), from the client's OpenAPI document,
 * packages/client-ts/openapi.json, which `npm run generate` there renders from the manifest; the SDK
 * itself never loads the manifest, so it needs nothing of polaris/core at runtime. Checked in and
 * drift-checked in CI: `bin/generate-routes && git diff --exit-code -- packages/agent/src/Routes.php`.
 */

$source = $argv[1] ?? __DIR__ . '/../../client-ts/openapi.json';
$document = json_decode((string) file_get_contents($source), true, flags: JSON_THROW_ON_ERROR);

/** The routes the SDK calls, by path and method. */
$wanted = [
    ['/.well-known/agent-configuration', 'get'],
    ['/agents/register', 'post'],
    ['/agents/enroll', 'post'],
    ['/agents/capabilities', 'get'],
    ['/agents/grants/request', 'post'],
    ['/agents/session', 'get'],
    ['/agents/execute', 'post'],
    ['/agents/receipts/{id}/verify', 'get'],
    ['/oauth2/token', 'post'],
    ['/auth/.well-known/jwks.json', 'get'],
];

$export = static fn(array $values): string => '[' . implode(', ', array_map(static fn(string $value): string => var_export($value, true), $values)) . ']';
$lines = [
    '<?php',
    '',
    'declare(strict_types=1);',
    '',
    'namespace Polaris\Agent;',
    '',
    '/**',
    ' * Generated by bin/generate-routes from packages/client-ts/openapi.json; do not edit. The agents, oauth',
    ' * and core routes the SDK calls: method, path, path parameters, body fields and the required ones.',
    ' */',
    'final class Routes',
    '{',
];
foreach ($wanted as [$path, $method]) {
    $operation = $document['paths'][$path][$method] ?? null;
    if ($operation === null) {
        fwrite(STDERR, strtoupper($method) . " $path is not in $source; regenerate the client first\n");
        exit(1);
    }
    $short = preg_replace('/Endpoint$/', '', (string) array_slice(explode('_', (string) $operation['operationId']), -1)[0]);
    $name = strtoupper((string) preg_replace('/(?<!^)[A-Z]/', '_$0', (string) $short));
    $schema = $operation['requestBody']['content']['application/json']['schema'] ?? [];
    $params = array_values(array_map(static fn(array $parameter): string => (string) $parameter['name'], array_filter($operation['parameters'] ?? [], static fn(array $parameter): bool => $parameter['in'] === 'path')));
    $lines[] = sprintf('    /** %s %s: %s */', strtoupper($method), $path, $operation['summary']);
    $lines[] = sprintf(
        "    public const array %s = ['method' => '%s', 'path' => '%s', 'params' => %s, 'fields' => %s, 'required' => %s];",
        $name,
        strtoupper($method),
        $path,
        $export($params),
        $export(array_keys($schema['properties'] ?? [])),
        $export($schema['required'] ?? []),
    );
}
$lines[] = '}';
$target = __DIR__ . '/../src/Routes.php';
file_put_contents($target, implode("\n", $lines) . "\n");
echo 'src/Routes.php: ' . count($wanted) . " routes\n";
