{
    "name": "@polaris-auth/client",
    "version": "0.9.0",
    "description": "Typed TypeScript client for Polaris for PHP, generated from the route manifest",
    "keywords": [
        "polaris",
        "authentication",
        "auth",
        "mfa",
        "totp",
        "jwt",
        "oauth",
        "sso",
        "scim",
        "rbac",
        "organizations",
        "multi-tenant",
        "php",
        "laravel",
        "symfony",
        "yii",
        "openapi",
        "openapi-fetch",
        "typescript",
        "client",
        "passkey",
        "webauthn",
        "social-login",
        "api-keys",
        "oauth2",
        "oauth2-server",
        "oidc",
        "openid-connect",
        "pkce",
        "dpop",
        "device-flow",
        "ciba",
        "token-exchange"
    ],
    "homepage": "https://github.com/univeros/polaris-core/tree/main/packages/client-ts#readme",
    "bugs": "https://github.com/univeros/polaris-core/issues",
    "license": "MIT",
    "author": {
        "name": "2am.tech",
        "url": "https://2am.tech"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/univeros/polaris-core.git",
        "directory": "packages/client-ts"
    },
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src",
        "openapi.json"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "generate": "php ../../bin/polaris manifest --format=openapi --bootstrap=polaris.php > openapi.json && openapi-typescript openapi.json -o src/schema.d.ts && node scripts/generate-namespaces.mjs",
        "typecheck": "tsc --noEmit",
        "build": "tsc -p tsconfig.build.json",
        "test": "vitest run",
        "e2e": "playwright test"
    },
    "dependencies": {
        "openapi-fetch": "^0.17.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.56.1",
        "@types/node": "^22.20.2",
        "openapi-typescript": "^7.13.0",
        "typescript": "^5.9.3",
        "vitest": "^4.1.11"
    }
}
