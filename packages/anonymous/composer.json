{
    "name": "polaris/anonymous",
    "description": "Anonymous sign-in for Polaris for PHP: guest sessions, an explicit conversion into a real account through a host hook, pruning of the guests nobody converted",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "2am.tech",
            "homepage": "https://2am.tech"
        }
    ],
    "require": {
        "php": ">=8.3",
        "polaris/cli": "^0.7",
        "polaris/core": "^0.7",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "symfony/console": "^7.0 || ^8.0",
        "symfony/uid": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Polaris\\Anonymous\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.7.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
