{
    "name": "polaris/oauth-provider",
    "description": "Polaris for PHP as an OAuth 2.1 and OpenID Connect provider: authorization code with PKCE, refresh rotation, client credentials, device flow, CIBA, token exchange, DPoP, dynamic registration and client ID metadata documents, discovery",
    "type": "library",
    "keywords": ["polaris", "oauth2", "oauth2-server", "oauth2-provider", "oidc", "openid-connect", "pkce", "dpop", "device-flow", "ciba", "token-exchange", "authorization-server", "php"],
    "license": "MIT",
    "authors": [
        {
            "name": "2am.tech",
            "homepage": "https://2am.tech"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-openssl": "*",
        "firebase/php-jwt": "^7.0",
        "lcobucci/jwt": "^5.6",
        "polaris/admin": "^0.8",
        "polaris/audit": "^0.8",
        "polaris/core": "^0.8",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/simple-cache": "^3.0",
        "symfony/uid": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Polaris\\OAuth\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.8.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
