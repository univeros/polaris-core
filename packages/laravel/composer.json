{
    "name": "polaris/laravel",
    "description": "Laravel adapter for Polaris for PHP: service provider, routes, guard, mail bridge, artisan commands",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "2am.tech",
            "homepage": "https://2am.tech"
        }
    ],
    "require": {
        "php": ">=8.3",
        "laravel/framework": "^13.0",
        "nyholm/psr7": "^1.8",
        "polaris/cli": "^0.2",
        "polaris/core": "^0.2",
        "polaris/pdo": "^0.2",
        "polaris/psr15": "^0.2",
        "symfony/psr-http-message-bridge": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Polaris\\Laravel\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        },
        "laravel": {
            "providers": [
                "Polaris\\Laravel\\PolarisServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
