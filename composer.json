{
    "name": "polaris/monorepo",
    "description": "Polaris for PHP: self-hosted authentication, MFA, organizations and RBAC for any PHP application",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "2am.tech",
            "homepage": "https://2am.tech"
        }
    ],
    "homepage": "https://github.com/univeros/polaris-core",
    "support": {
        "issues": "https://github.com/univeros/polaris-core/issues",
        "source": "https://github.com/univeros/polaris-core"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "polaris/admin": "0.3.x-dev",
                    "polaris/audit": "0.3.x-dev",
                    "polaris/cli": "0.3.x-dev",
                    "polaris/core": "0.3.x-dev",
                    "polaris/laravel": "0.3.x-dev",
                    "polaris/messaging": "0.3.x-dev",
                    "polaris/pdo": "0.3.x-dev",
                    "polaris/psr15": "0.3.x-dev",
                    "polaris/sentinel": "0.3.x-dev",
                    "polaris/symfony": "0.3.x-dev",
                    "polaris/testing": "0.3.x-dev",
                    "polaris/yii": "0.3.x-dev"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.3",
        "polaris/admin": "0.3.x-dev",
        "polaris/audit": "0.3.x-dev",
        "polaris/cli": "0.3.x-dev",
        "polaris/core": "0.3.x-dev",
        "polaris/laravel": "0.3.x-dev",
        "polaris/messaging": "0.3.x-dev",
        "polaris/pdo": "0.3.x-dev",
        "polaris/psr15": "0.3.x-dev",
        "polaris/sentinel": "0.3.x-dev",
        "polaris/symfony": "0.3.x-dev",
        "polaris/testing": "0.3.x-dev",
        "polaris/yii": "0.3.x-dev"
    },
    "require-dev": {
        "httpsoft/http-message": "^1.1",
        "laminas/laminas-diactoros": "^3.0",
        "maxmind-db/reader": "^1.12",
        "orchestra/testbench-core": "^11.4",
        "phpmailer/phpmailer": "^6.9",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5",
        "squizlabs/php_codesniffer": "^3.13.6",
        "symfony/mailer": "^7.4 || ^8.0",
        "yiisoft/di": "^1.3",
        "yiisoft/mailer": "^6.1",
        "yiisoft/request-body-parser": "^1.1",
        "yiisoft/router-fastroute": "^4.0",
        "yiisoft/yii-console": "^2.4",
        "yiisoft/yii-event": "^2.2",
        "yiisoft/yii-http": "^1.1"
    },
    "autoload-dev": {
        "psr-4": {
            "Polaris\\Admin\\Tests\\": "packages/admin/tests/",
            "Polaris\\Audit\\Tests\\": "packages/audit/tests/",
            "Polaris\\Laravel\\Tests\\": "packages/laravel/tests/",
            "Polaris\\Messaging\\Tests\\": "packages/messaging/tests/",
            "Polaris\\Sentinel\\Tests\\": "packages/sentinel/tests/",
            "Polaris\\Symfony\\Tests\\": "packages/symfony/tests/",
            "Polaris\\Tests\\": "packages/core/tests/",
            "Polaris\\Yii\\Tests\\": "packages/yii/tests/"
        }
    },
    "scripts": {
        "cs": "phpcs",
        "cs-fix": "phpcbf",
        "stan": "phpstan analyse",
        "imports": "bin/check-imports",
        "test": "phpunit",
        "test:laravel": [
            "@putenv POLARIS_HARNESS=Polaris\\Laravel\\Tests\\Harness",
            "phpunit --testsuite functional"
        ],
        "test:symfony": [
            "@putenv POLARIS_HARNESS=Polaris\\Symfony\\Tests\\Harness",
            "phpunit --testsuite functional"
        ],
        "test:yii": [
            "@putenv POLARIS_HARNESS=Polaris\\Yii\\Tests\\Harness",
            "phpunit --testsuite functional"
        ],
        "qa": [
            "@cs",
            "@stan",
            "@imports",
            "@test",
            "@test:laravel",
            "@test:symfony",
            "@test:yii"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
