{
    "name": "polaris/monorepo",
    "description": "Polaris for PHP: self-hosted authentication, MFA, organizations and RBAC for any PHP application",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/univeros/polaris-core",
    "support": {
        "issues": "https://github.com/univeros/polaris-core/issues",
        "source": "https://github.com/univeros/polaris-core"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "polaris/cli": "0.1.x-dev",
                    "polaris/core": "0.1.x-dev",
                    "polaris/pdo": "0.1.x-dev",
                    "polaris/psr15": "0.1.x-dev",
                    "polaris/testing": "0.1.x-dev"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.3",
        "polaris/cli": "0.1.x-dev",
        "polaris/core": "0.1.x-dev",
        "polaris/pdo": "0.1.x-dev",
        "polaris/psr15": "0.1.x-dev",
        "polaris/testing": "0.1.x-dev"
    },
    "require-dev": {
        "laminas/laminas-diactoros": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5",
        "squizlabs/php_codesniffer": "^3.13.6"
    },
    "autoload-dev": {
        "psr-4": {
            "Polaris\\Tests\\": "packages/core/tests/"
        }
    },
    "scripts": {
        "cs": "phpcs",
        "cs-fix": "phpcbf",
        "stan": "phpstan analyse",
        "imports": "bin/check-imports",
        "test": "phpunit",
        "qa": [
            "@cs",
            "@stan",
            "@imports",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
